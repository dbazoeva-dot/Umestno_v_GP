# Шаблон переменных окружения для Umestno API.
# На VPS скопировать в .env и заполнить (файл .env в .gitignore).

# ── Node API ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production
IMAGE_BASE_URL=/assets/images/sku

# ── Paywall ───────────────────────────────────────────────
# В проде ВСЕГДА true. false — dev-обход для локальной разработки
# без поднятой YooKassa-интеграции (см. docs/data-model.md).
PAYMENT_REQUIRED=false
# Цена услуги в копейках (149 ₽ = 14900). Должна совпадать с
# текстом в /oferta/. При изменении — править оба места + рестарт Node.
PRICE_KOP=14900
# Базовый URL сайта для return_url в YooKassa-платежах.
SITE_BASE_URL=https://umestno-home.ru

# ── YooKassa ──────────────────────────────────────────────
# Получить в личном кабинете umestno-home → Интеграция → Ключи API.
# Shop ID виден в шапке, Secret Key выпускается кнопкой «Выпустить ключ»
# (показывается ОДИН РАЗ — сразу сохранить!).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ── Postgres ──────────────────────────────────────────────
# Node-овский `pg` НЕ читает ~/.pgpass (это умеет только psql-CLI).
# Поэтому PGPASSWORD обязательно явно. Остальные поля — с дефолтами,
# но лучше тоже задать явно.
#
# ВАЖНО: пароль ОБЯЗАТЕЛЬНО оборачивать в одинарные кавычки.
# Без кавычек dotenv режет значение на первом #, $, пробеле и
# подобных спецсимволах — пароль приедет в Node обрезанным,
# Postgres вернёт "password authentication failed".
PGHOST=localhost
PGPORT=5432
PGDATABASE=umestno
PGUSER=umestno_app
PGPASSWORD='пароль_здесь_в_одинарных_кавычках'

# ── Доверенные IP (опционально) ───────────────────────────
# Полностью обходят rate-limit на /api/calculate. Удобно для
# собственного тестирования с прод-домена. IP через запятую без
# пробелов. Узнать свой текущий: curl -sS https://ifconfig.me
# ADMIN_IPS=1.2.3.4,5.6.7.8

# ── Будущие интеграции (Stage 2+) ─────────────────────────
# UNISENDER_API_KEY=
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
