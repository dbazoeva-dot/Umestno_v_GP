# Шаблон переменных окружения для Umestno API.
# На VPS скопировать в .env и заполнить (файл .env в .gitignore).

# ── Node API ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production
IMAGE_BASE_URL=/assets/images/sku

# ── Postgres ──────────────────────────────────────────────
# Если ~/.pgpass настроен — оставить закомментированным, Node
# подхватит из него. Если хочется явно — раскомментировать.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=umestno
# PGUSER=umestno_app
# PGPASSWORD=

# ── Будущие интеграции (Stage 2+) ─────────────────────────
# UNISENDER_API_KEY=
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
