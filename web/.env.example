# Email (Yandex SMTP or any SMTP)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@your-domain.ru
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@your-domain.ru
