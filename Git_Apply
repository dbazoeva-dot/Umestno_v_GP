+export function applyOpenFallback({ candidate, availableBox, openResult, layoutPlan, calculatedZones }: { candidate: CalculatedZone; availableBox: { w_cm:number; d_cm:number; h_cm:number; x_cm:number; y_cm:number }; openResult: { cols:number; rows:number; capacity:number; reserveCapacity:number; heightOk:boolean }; layoutPlan: LayoutPlan; calculatedZones: CalculatedZone[] }) {
+  const openZone: CalculatedZone = { ...candidate, zone_id: `${candidate.content_type}_open_fallback`, division_type: "open", calculation_mode: "open_capacity_in_box", option_id: "open_single_section", zone_w_cm: availableBox.w_cm, zone_d_cm: availableBox.d_cm, zone_h_cm: availableBox.h_cm, capacity: openResult.capacity, calculated_cols: openResult.cols, calculated_rows: openResult.rows, original_failed_division: candidate.division_type, original_failed_option_id: candidate.option_id, assigned_box_w_cm: availableBox.w_cm, assigned_box_d_cm: availableBox.d_cm, assigned_box_h_cm: availableBox.h_cm, open_capacity: openResult.capacity, reserve_capacity: openResult.reserveCapacity, height_ok: openResult.heightOk, why_open_fallback: `${candidate.content_type} failed as ${candidate.division_type}; open fallback is allowed, low enough rank, and available box fits required count.` };
