+import type { CalculatedZone, CountedItem, FitResult, LayoutPlan, NormalizedInput, SchemePayload, StorageRequirement, ValidationResult } from "../types.js";
+export function buildSchemePayload({ input, calculatedZones, layoutPlan, fitResult, adjustment, validation }: { input: NormalizedInput; countedItems: CountedItem[]; storageRequirements: StorageRequirement[]; calculatedZones: CalculatedZone[]; layoutPlan: LayoutPlan; fitResult: FitResult; adjustment: unknown; validation?: ValidationResult }): SchemePayload {
